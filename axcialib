    local function switchTab(idx)
        if idx == _currentTab then return end
        snd(1083195953, 0.2, 0.96 + idx * 0.03)

        local prev = _tabFrames[_currentTab]
        local next = _tabFrames[idx]

        if prev.Name ~= "ColTab" then
            tw(prev, {BackgroundTransparency = 1}, 0.15, Enum.EasingStyle.Quart)
        end
        task.delay(0.17, function()
            prev.Visible = false
            if prev.Name ~= "ColTab" then
                prev.BackgroundTransparency = 0.08
            end
        end)

        _currentTab = idx
        next.Visible = true

        if next.Name ~= "ColTab" then
            next.BackgroundTransparency = 1
            tw(next, {BackgroundTransparency = 0.08}, 0.22, Enum.EasingStyle.Quart)
        end

        local baseY = next.Position.Y.Offset
        next.Position = UDim2.new(next.Position.X.Scale, next.Position.X.Offset, next.Position.Y.Scale, baseY + 12)
        tw(next, {Position = UDim2.new(next.Position.X.Scale, next.Position.X.Offset, next.Position.Y.Scale, baseY)}, 0.28, Enum.EasingStyle.Quart)

        for i, btn in ipairs(_tabBtns) do
            local img = btn:FindFirstChildOfClass("ImageLabel")
            if i == idx then
                tw(btn, {BackgroundColor3 = Color3.fromRGB(22, 22, 26)}, 0.18)
                if img then tw(img, {ImageTransparency = 0}, 0.18) end
            else
                tw(btn, {BackgroundColor3 = Color3.fromRGB(10, 10, 12)}, 0.18)
                if img then tw(img, {ImageTransparency = 0.55}, 0.18) end
            end
        end
    end

    for i, asset in ipairs(iconAssets) do
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(0, 36, 0, 34)
        btn.BackgroundColor3 = i == 1 and Color3.fromRGB(22,22,26) or Color3.fromRGB(10,10,12)
