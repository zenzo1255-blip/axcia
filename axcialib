                                    eye2.Position = UDim2.new(0, 26, 0, 12)
                                    eye2.BackgroundColor3 = Color3.fromRGB(20,20,20)
                                    eye2.ZIndex = 9
                                    makeCorner(eye2, 3)
                                    eye2.Parent = faceOnly

                                    tween(axcia, {BackgroundTransparency = 1}, 0.4)
                                    fadeChildren(axcia)

                                    task.delay(0.5, function()
                                        tween(faceOnly, {
                                            Size = UDim2.new(0, 90, 0, 90),
                                            Position = UDim2.new(0.5, -45, 0.5, -45),
                                            BackgroundColor3 = Color3.fromRGB(220, 20, 60)
                                        }, 0.5, Enum.EasingStyle.Back)

                                        task.delay(0.5, function()
                                            tween(faceOnly, {BackgroundTransparency = 1}, 0.3)
                                            tween(eye1, {BackgroundTransparency = 1}, 0.3)
                                            tween(eye2, {BackgroundTransparency = 1}, 0.3)

                                            task.delay(0.3, function()
                                                local logoA = Instance.new("TextLabel")
                                                logoA.Size = UDim2.new(0, 0, 0, 90)
                                                logoA.Position = UDim2.new(0.5, 0, 0.5, -45)
