        tooltip.TextColor3 = Color3.fromRGB(200,200,200)
        tooltip.TextSize = 10
        tooltip.Font = Enum.Font.GothamBold
        tooltip.BorderSizePixel = 0
        tooltip.BackgroundTransparency = 1
        tooltip.TextTransparency = 1
        tooltip.ZIndex = 20
        makeCorner(tooltip, 4)
        tooltip.Parent = btn

        btn.MouseEnter:Connect(function()
            tween(tooltip, {BackgroundTransparency = 0.2, TextTransparency = 0}, 0.15)
        end)
        btn.MouseLeave:Connect(function()
            tween(tooltip, {BackgroundTransparency = 1, TextTransparency = 1}, 0.15)
        end)

        btn.MouseButton1Click:Connect(function()
            for j, tb in ipairs(tabButtons) do
                tween(tb, {BackgroundColor3 = Color3.fromRGB(20,20,22), TextColor3 = Color3.fromRGB(140,140,150)}, 0.2)
            end
            tween(btn, {BackgroundColor3 = Color3.fromRGB(35,35,40), TextColor3 = Color3.fromRGB(0,255,128)}, 0.2)
            switchTab(i)
        end)

        table.insert(tabButtons, btn)
    end

