        task.delay(0.18, function()
            oldFrame.Visible = false
            if oldFrame.Name ~= "ColHolder" then
                oldFrame.BackgroundTransparency = 0
            end
        end)

        currentTabIdx = idx

        newFrame.Visible = true
        if newFrame.Name == "ColHolder" then
            newFrame.BackgroundTransparency = 1
        else
            newFrame.BackgroundTransparency = 1
            tw(newFrame, {BackgroundTransparency = 0}, 0.22, Enum.EasingStyle.Quart)
        end

        local origPos = newFrame.Position
        newFrame.Position = UDim2.new(origPos.X.Scale, origPos.X.Offset, origPos.Y.Scale, origPos.Y.Offset + 14)
        tw(newFrame, {Position = origPos}, 0.3, Enum.EasingStyle.Quart)

        for i, btn in ipairs(tabBtnList) do
            if i == idx then
                tw(btn, {BackgroundColor3 = Color3.fromRGB(30,30,36)}, 0.2)
                btn.TextColor3 = Color3.fromRGB(0,255,128)
            else
                tw(btn, {BackgroundColor3 = Color3.fromRGB(16,16,18)}, 0.2)
