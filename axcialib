                                                logoA.TextColor3 = Color3.fromRGB(220, 20, 60)
                                                logoA.TextSize = 90
                                                logoA.Font = Enum.Font.GothamBlack
                                                logoA.TextTransparency = 1
                                                logoA.ZIndex = 10
                                                logoA.Parent = canvas

                                                tween(logoA, {
                                                    Size = UDim2.new(0, 90, 0, 90),
                                                    Position = UDim2.new(0.5, -45, 0.5, -45),
                                                    TextTransparency = 0
