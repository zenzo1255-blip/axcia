local function tw(obj, props, dur, style, dir)
    local info = TweenInfo.new(
        dur   or 0.3,
        style or Enum.EasingStyle.Quart,
        dir   or Enum.EasingDirection.Out
    )
    local t = TweenService:Create(obj, info, props)
    t:Play()
    return t
end

local function corner(p, r)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, r or 6)
    c.Parent = p
    return c
end

local function stroke(p, col, thick, tr)
    local s = Instance.new("UIStroke")
    s.Color = col or Color3.fromRGB(255,255,255)
    s.Thickness = thick or 1
    s.Transparency = tr or 0.85
    s.Parent = p
    return s
end

local function playSound(id, vol, pitch)
    local s = Instance.new("Sound")
    s.SoundId = "rbxassetid://" .. tostring(id)
    s.Volume = vol or 0.4
    s.PlaybackSpeed = pitch or 1
    s.Parent = SoundService
    s:Play()
    Debris:AddItem(s, 4)
end

local function ripple(btn)
    local r = Instance.new("Frame")
    r.Size = UDim2.new(0,0,0,0)
    r.Position = UDim2.new(0.5,0,0.5,0)
    r.AnchorPoint = Vector2.new(0.5,0.5)
    r.BackgroundColor3 = Color3.fromRGB(255,255,255)
    r.BackgroundTransparency = 0.65
    r.ZIndex = (btn.ZIndex or 1) + 3
    r.Parent = btn
    corner(r, 99)
    tw(r, {Size = UDim2.new(2,0,2,0), BackgroundTransparency = 1}, 0.4, Enum.EasingStyle.Quart)
    Debris:AddItem(r, 0.5)
end

local function cfgExists()
    if not isfolder then return false end
    return isfolder(CFG_FOLDER) and isfile(CFG_FILE)
end

local function loadCfg()
    if not cfgExists() then return nil end
    local ok, d = pcall(function() return HttpService:JSONDecode(readfile(CFG_FILE)) end)
    return ok and d or nil
end

local function saveCfg(data)
    if not makefolder or not writefile then return end
    if not isfolder(CFG_FOLDER) then makefolder(CFG_FOLDER) end
    local ok, s = pcall(function() return HttpService:JSONEncode(data) end)
    if ok then writefile(CFG_FILE, s) end
end

local LoadingScreen = {}

function LoadingScreen.run(onDone)
