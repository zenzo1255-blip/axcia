        function colObj:AddSlider(sOpts)
            sOpts = sOpts or {}
            local name     = (sOpts.Name or "Slider"):upper()
            local minVal   = sOpts.Min     or 0
            local maxVal   = sOpts.Max     or 100
            local defVal   = sOpts.Default or minVal
            local callback = sOpts.Callback or function() end
            local value    = math.clamp(defVal, minVal, maxVal)

            local row = Instance.new("Frame")
            row.Size = UDim2.new(1,0,0,46)
            row.BackgroundTransparency = 1
            row.Parent = itemsFrame

            local topRow = Instance.new("Frame")
