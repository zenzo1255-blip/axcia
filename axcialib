local function safeSound(id, vol, pitch)
    local s = Instance.new("Sound")
    s.SoundId = "rbxassetid://" .. tostring(id)
    s.Volume = vol or 0.4
    s.PlaybackSpeed = pitch or 1
    s.Parent = SoundService
    s:Play()
    game:GetService("Debris"):AddItem(s, 3)
end

local function tween(obj, props, t, style, dir)
    local info = TweenInfo.new(t or 0.25, style or Enum.EasingStyle.Quart, dir or Enum.EasingDirection.Out)
    local tw = TweenService:Create(obj, info, props)
    tw:Play()
    return tw
end

local function ripple(btn)
    local ripFrame = Instance.new("Frame")
    ripFrame.Size = UDim2.new(0, 0, 0, 0)
    ripFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
    ripFrame.AnchorPoint = Vector2.new(0.5, 0.5)
    ripFrame.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    ripFrame.BackgroundTransparency = 0.7
    ripFrame.ZIndex = btn.ZIndex + 2
    ripFrame.Parent = btn
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(1, 0)
    c.Parent = ripFrame
    tween(ripFrame, {Size = UDim2.new(2, 0, 2, 0), BackgroundTransparency = 1}, 0.45, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
    task.delay(0.5, function() ripFrame:Destroy() end)
end

local function makeCorner(parent, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 6)
    c.Parent = parent
    return c
end

local function makeStroke(parent, color, thickness, trans)
    local s = Instance.new("UIStroke")
    s.Color = color or Color3.fromRGB(255, 255, 255)
    s.Thickness = thickness or 1
    s.Transparency = trans or 0.8
    s.Parent = parent
    return s
end

local function hexToColor(hex)
    hex = hex:gsub("#", "")
    return Color3.fromRGB(
        tonumber(hex:sub(1,2), 16),
        tonumber(hex:sub(3,4), 16),
        tonumber(hex:sub(5,6), 16)
    )
end

local function lerp(a, b, t)
    return a + (b - a) * t
end

local function lerpColor(c1, c2, t)
    return Color3.new(
        lerp(c1.R, c2.R, t),
        lerp(c1.G, c2.G, t),
        lerp(c1.B, c2.B, t)
    )
end

local function getRainbow(offset)
    offset = offset or 0
    local t = (tick() * 0.4 + offset) % 1
    local h = t
    return Color3.fromHSV(h, 1, 1)
end

local function configExists()
    if not isfolder then return false end
    return isfolder(configFolder) and isfile(configFile)
end

local function loadConfig()
    if not configExists() then return nil end
    local ok, data = pcall(function() return HttpService:JSONDecode(readfile(configFile)) end)
    if ok then return data end
    return nil
end

local function saveConfig(data)
    if not makefolder or not writefile then return end
    if not isfolder(configFolder) then makefolder(configFolder) end
    local ok, encoded = pcall(function() return HttpService:JSONEncode(data) end)
    if ok then writefile(configFile, encoded) end
end

local LoadingScreen = {}

function LoadingScreen.create(callback)
    local gui = Instance.new("ScreenGui")
    gui.Name = "AxciaLoading"
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

    local ok, _ = pcall(function() gui.Parent = CoreGui end)
    if not ok then gui.Parent = LocalPlayer.PlayerGui end

