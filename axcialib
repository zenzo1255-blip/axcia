        local mouthL = makeFrame(parts.head, 3,2, 5,18, Color3.fromRGB(40,20,20), 6, 1)
        local mouthR = makeFrame(parts.head, 3,2, 15,18, Color3.fromRGB(40,20,20), 6, 1)
        parts.eyeL = eyeL
        parts.eyeR = eyeR

        local neckH = 6
        parts.neck = makeFrame(root, 8,neckH, -4,-neckH-14, skinColor, 5, 2)

        local bodyH = 30
        parts.body = makeFrame(root, 20,bodyH, -10,-bodyH-20+neckH+2, shirtColor, 5, 2)

        local armW, armH = 7, 26
        parts.armL = makeFrame(root, armW,armH, -10-armW+2,-42, skinColor, 5, 3)
        parts.armR = makeFrame(root, armW,armH, 10-2,-42, skinColor, 5, 3)

