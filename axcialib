local function tw(o, p, d, s, dir)
    local t = TweenSvc:Create(o, TweenInfo.new(d or 0.25, s or Enum.EasingStyle.Quart, dir or Enum.EasingDirection.Out), p)
    t:Play()
    return t
end

local function mkCorner(p, r)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, r or 6)
    c.Parent = p
end

local function mkStroke(p, col, th, tr)
    local s = Instance.new("UIStroke")
    s.Color = col or Color3.fromRGB(255,255,255)
    s.Thickness = th or 1
    s.Transparency = tr or 0.85
    s.Parent = p
    return s
end

local function snd(id, vol, pitch)
    local s = Instance.new("Sound")
    s.SoundId = "rbxassetid://" .. id
    s.Volume = vol or 0.35
    s.PlaybackSpeed = pitch or 1
    s.Parent = SoundSvc
    s:Play()
    Debris:AddItem(s, 3)
end

local function ripple(btn)
    local f = Instance.new("Frame")
    f.Size = UDim2.new(0,0,0,0)
    f.Position = UDim2.new(0.5,0,0.5,0)
    f.AnchorPoint = Vector2.new(0.5,0.5)
    f.BackgroundColor3 = Color3.fromRGB(255,255,255)
    f.BackgroundTransparency = 0.7
    f.ZIndex = (btn.ZIndex or 1) + 5
    f.Parent = btn
    mkCorner(f, 99)
    tw(f, {Size = UDim2.new(2.5,0,2.5,0), BackgroundTransparency = 1}, 0.45, Enum.EasingStyle.Quart)
    Debris:AddItem(f, 0.5)
end

local function cfgOk()
    if not isfolder then return false end
    return isfolder(CFG_FOLDER) and isfile(CFG_FILE)
end

local function loadCfg()
    if not cfgOk() then return nil end
    local ok, d = pcall(function() return Http:JSONDecode(readfile(CFG_FILE)) end)
    return ok and d or nil
end

local function saveCfg(data)
    if not makefolder or not writefile then return end
    if not isfolder(CFG_FOLDER) then makefolder(CFG_FOLDER) end
    local ok, s = pcall(function() return Http:JSONEncode(data) end)
    if ok then writefile(CFG_FILE, s) end
end

