    local function toggleUI()
        uiVisible = not uiVisible
        safeSound(uiVisible and 3306536429 or 3306536430, 0.5, 1)
        for _, tf in ipairs(tabFrames) do
            if tf.Visible or uiVisible then
                tf.Visible = uiVisible and (tabFrames[currentTabIndex] == tf)
            end
        end
        if uiVisible then
            tabBarFrame.Visible = true
            tween(tabBarFrame, {BackgroundTransparency = 0, Position = UDim2.new(0.5,-80,1,-80)}, 0.35, Enum.EasingStyle.Back)
            tabFrames[currentTabIndex].Visible = true
            tabFrames[currentTabIndex].BackgroundTransparency = 1
            tween(tabFrames[currentTabIndex], {BackgroundTransparency = currentTabIndex == 1 and 1 or 0}, 0.3)
        else
            tween(tabBarFrame, {BackgroundTransparency = 1, Position = UDim2.new(0.5,-80,1,-60)}, 0.25, Enum.EasingStyle.Quart)
            task.delay(0.3, function() tabBarFrame.Visible = false end)
        end
    end

    mobileBtn.MouseButton1Click:Connect(toggleUI)

    UserInputService.InputBegan:Connect(function(inp, processed)
        if processed then return end
        if inp.KeyCode == Enum.KeyCode.RightShift then
            toggleUI()
        end
    end)

    local rgbConn
    rgbConn = RunService.Heartbeat:Connect(function()
        if not settingsData.RGBArrayList then return end
        local col = getRainbow(0)
        if tabBarFrame and tabBarFrame.Parent then
            for _, btn in ipairs(tabButtons) do
                if btn.TextColor3 ~= Color3.fromRGB(140,140,150) then
                    btn.TextColor3 = col
                end
            end
        end
    end)

    return {
        tabFrames = tabFrames,
        tabBar = tabBarFrame,
        columnContainer = columnContainer,
        switchTab = switchTab
    }
end

