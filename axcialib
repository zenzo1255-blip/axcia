        container.Size = UDim2.new(0, 40, 0, 80)
        container.Position = UDim2.new(0, x, 0, y)
        container.BackgroundTransparency = 1
        container.Parent = parent

        local function part(name, sx, sy, px, py, color, zindex)
            local f = Instance.new("Frame")
            f.Name = name
            f.Size = UDim2.new(0, sx, 0, sy)
            f.Position = UDim2.new(0, px, 0, py)
            f.BackgroundColor3 = color or Color3.fromRGB(255,255,255)
            f.BorderSizePixel = 0
            f.ZIndex = zindex or 2
            makeCorner(f, 4)
            f.Parent = container
            return f
        end

        local head = part("Head", 18, 18, 11, 0, Color3.fromRGB(240,200,150))
        local headEye1 = part("Eye1", 3, 3, 15, 5, Color3.fromRGB(20,20,20), 3)
        local headEye2 = part("Eye2", 3, 3, 21, 5, Color3.fromRGB(20,20,20), 3)
        local body = part("Body", 10, 22, 15, 20, Color3.fromRGB(80,120,200))
        local lArm = part("LArm", 5, 18, 8, 22, Color3.fromRGB(240,200,150))
        local rArm = part("RArm", 5, 18, 27, 22, Color3.fromRGB(240,200,150))
        local lLeg = part("LLeg", 5, 20, 12, 43, Color3.fromRGB(60,80,140))
        local rLeg = part("RLeg", 5, 20, 23, 43, Color3.fromRGB(60,80,140))

        if tag then
            local nametag = Instance.new("TextLabel")
            nametag.Size = UDim2.new(0, 70, 0, 18)
            nametag.Position = UDim2.new(0, -15, 0, -22)
            nametag.BackgroundColor3 = Color3.fromRGB(0,0,0)
            nametag.BackgroundTransparency = 0.35
            nametag.Text = tag
            nametag.TextColor3 = tagColor or Color3.fromRGB(255,255,255)
            nametag.TextSize = 11
            nametag.Font = Enum.Font.GothamBold
            nametag.BorderSizePixel = 0
            nametag.ZIndex = 4
            nametag.Parent = container
            makeCorner(nametag, 3)
        end

        return container, {head=head, lArm=lArm, rArm=rArm, lLeg=lLeg, rLeg=rLeg, body=body}
    end

    local screenW = workspace.CurrentCamera.ViewportSize.X
    local screenH = workspace.CurrentCamera.ViewportSize.Y
    local groundY = screenH * 0.72 - 80

    local voxels, voxelParts = makeStickman(canvas, screenW * 0.42, groundY, "Voxels", Color3.fromRGB(255,255,100))
    local axcia, axciaParts = makeStickman(canvas, -60, groundY, "Axcia", Color3.fromRGB(255,100,100))
    axcia.BackgroundTransparency = 1

    local function setBodyColor(parts, color)
        for _, p in pairs(parts) do
            if p.Name ~= "Eye1" and p.Name ~= "Eye2" then
                p.BackgroundColor3 = color
            end
        end
    end
    setBodyColor(axciaParts, Color3.fromRGB(255,255,255))
    axciaParts.head.BackgroundColor3 = Color3.fromRGB(255,255,255)

    local idleConn
    local idleT = 0
    idleConn = RunService.Heartbeat:Connect(function(dt)
        idleT = idleT + dt * 3
        local bob = math.sin(idleT) * 3
        voxelParts.lArm.Rotation = math.sin(idleT * 0.7) * 8
        voxelParts.rArm.Rotation = -math.sin(idleT * 0.7) * 8
        voxelParts.head.Position = UDim2.new(0, 11, 0, bob * 0.3)
    end)

    task.delay(0.8, function()
        tween(axcia, {Position = UDim2.new(0, screenW * 0.55, 0, groundY)}, 1.4, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
        local walkConn
        local walkT = 0
        walkConn = RunService.Heartbeat:Connect(function(dt)
            walkT = walkT + dt * 8
            axciaParts.lLeg.Rotation = math.sin(walkT) * 25
            axciaParts.rLeg.Rotation = -math.sin(walkT) * 25
            axciaParts.lArm.Rotation = -math.sin(walkT) * 20
            axciaParts.rArm.Rotation = math.sin(walkT) * 20
        end)

        task.delay(1.4, function()
            walkConn:Disconnect()
            axciaParts.lLeg.Rotation = 0
            axciaParts.rLeg.Rotation = 0
            axciaParts.lArm.Rotation = 0
            axciaParts.rArm.Rotation = 0

            task.delay(0.3, function()
                local gun = Instance.new("Frame")
                gun.Size = UDim2.new(0, 20, 0, 7)
                gun.Position = UDim2.new(0, 32, 0, 30)
                gun.BackgroundColor3 = Color3.fromRGB(60,60,60)
                gun.BorderSizePixel = 0
                gun.ZIndex = 3
                makeCorner(gun, 2)
                gun.Parent = axcia

                tween(axciaParts.rArm, {Rotation = -60}, 0.2)
                task.delay(0.5, function()
                    safeSound(131961141, 0.6, 1.2)

                    local flash = Instance.new("Frame")
                    flash.Size = UDim2.new(0, 12, 0, 12)
                    flash.Position = UDim2.new(0, 50, 0, 27)
                    flash.BackgroundColor3 = Color3.fromRGB(255, 220, 80)
                    flash.BorderSizePixel = 0
                    flash.ZIndex = 5
                    makeCorner(flash, 6)
                    flash.Parent = axcia
                    tween(flash, {BackgroundTransparency = 1, Size = UDim2.new(0,20,0,20)}, 0.15)
                    task.delay(0.15, function() flash:Destroy() end)

                    idleConn:Disconnect()
                    tween(voxels, {Rotation = 90, Position = UDim2.new(0, screenW * 0.42, 0, groundY + 20)}, 0.4, Enum.EasingStyle.Back)
                    tween(voxelParts.head, {BackgroundColor3 = Color3.fromRGB(200, 50, 50)}, 0.1)

                    task.delay(0.7, function()
                        tween(axciaParts.rArm, {Rotation = 0}, 0.3)

                        task.delay(0.5, function()
                            local stareConn
                            local stareT = 0
                            stareConn = RunService.Heartbeat:Connect(function(dt)
                                stareT = stareT + dt
                                if stareT > 1.5 then
                                    stareConn:Disconnect()
                                end
                            end)

                            task.delay(1.8, function()
                                tween(voxels, {BackgroundTransparency = 1}, 0.6)

                                local function fadeChildren(inst)
                                    for _, c in ipairs(inst:GetChildren()) do
                                        if c:IsA("GuiObject") then
                                            tween(c, {BackgroundTransparency = 1}, 0.6)
                                            if c:IsA("TextLabel") then
                                                tween(c, {TextTransparency = 1}, 0.6)
                                            end
                                            fadeChildren(c)
                                        end
                                    end
                                end
                                fadeChildren(voxels)

                                tween(ground, {BackgroundTransparency = 1}, 0.5)

                                task.delay(0.5, function()
                                    local faceOnly = Instance.new("Frame")
                                    faceOnly.Size = UDim2.new(0, 40, 0, 40)
                                    faceOnly.Position = UDim2.new(0.5, -20, 0.5, -20)
                                    faceOnly.BackgroundColor3 = Color3.fromRGB(255,255,255)
                                    faceOnly.BorderSizePixel = 0
                                    faceOnly.ZIndex = 8
