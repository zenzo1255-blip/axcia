            dropList.ClipsDescendants = true
            dropList.ZIndex = 15
            makeCorner(dropList, 5)
            dropList.Parent = dropBtn

            local dropLayout = Instance.new("UIListLayout")
            dropLayout.Parent = dropList

            for _, item in ipairs(items) do
                local opt = Instance.new("TextButton")
                opt.Size = UDim2.new(1, 0, 0, 22)
                opt.BackgroundTransparency = 1
                opt.Text = tostring(item)
                opt.TextColor3 = Color3.fromRGB(190,190,195)
                opt.TextSize = 10
                opt.Font = Enum.Font.GothamBold
                opt.ZIndex = 16
                opt.Parent = dropList
                opt.MouseButton1Click:Connect(function()
                    selected = tostring(item)
                    dropBtn.Text = selected
                    open = false
                    tween(dropList, {Size = UDim2.new(1,0,0,0)}, 0.2, Enum.EasingStyle.Quart)
                    tween(arrow, {Rotation = 0}, 0.2)
                    task.spawn(callback, selected)
                end)
            end

            dropBtn.MouseButton1Click:Connect(function()
                open = not open
                local targetH = open and (#items * 22) or 0
                tween(dropList, {Size = UDim2.new(1,0,0,targetH)}, 0.22, Enum.EasingStyle.Quart)
                tween(arrow, {Rotation = open and 180 or 0}, 0.2)
            end)

            local dropRef = {}
            function dropRef:Set(val) selected = val; dropBtn.Text = val; callback(val) end
            function dropRef:Get() return selected end
            return dropRef
        end

        function colObj:AddLabel(text)
            local lbl = Instance.new("TextLabel")
            lbl.Size = UDim2.new(1, 0, 0, 26)
            lbl.BackgroundTransparency = 1
            lbl.Text = (text or ""):upper()
            lbl.TextColor3 = Color3.fromRGB(120,120,130)
            lbl.TextSize = 10
            lbl.Font = Enum.Font.GothamBold
            lbl.TextXAlignment = Enum.TextXAlignment.Left
            lbl.LetterSpacing = 2
            lbl.Parent = itemList
            return lbl
        end

        function colObj:AddTextbox(tbOptions)
            tbOptions = tbOptions or {}
            local lbl = tbOptions.Name or "Textbox"
            local placeholder = tbOptions.Placeholder or "Enter text..."
            local callback = tbOptions.Callback or function() end

            local row = Instance.new("Frame")
            row.Size = UDim2.new(1, 0, 0, 44)
            row.BackgroundTransparency = 1
            row.Parent = itemList

            local nameLbl = Instance.new("TextLabel")
            nameLbl.Size = UDim2.new(1, 0, 0, 16)
            nameLbl.BackgroundTransparency = 1
            nameLbl.Text = lbl:upper()
            nameLbl.TextColor3 = Color3.fromRGB(210,210,215)
            nameLbl.TextSize = 11
            nameLbl.Font = Enum.Font.GothamBold
            nameLbl.TextXAlignment = Enum.TextXAlignment.Left
            nameLbl.LetterSpacing = 1
            nameLbl.Parent = row

            local box = Instance.new("TextBox")
            box.Size = UDim2.new(1, 0, 0, 24)
            box.Position = UDim2.new(0, 0, 0, 18)
            box.BackgroundColor3 = Color3.fromRGB(28,28,32)
            box.Text = ""
            box.PlaceholderText = placeholder
            box.PlaceholderColor3 = Color3.fromRGB(90,90,100)
            box.TextColor3 = Color3.fromRGB(210,210,215)
            box.TextSize = 11
            box.Font = Enum.Font.Gotham
            box.BorderSizePixel = 0
            box.ClearTextOnFocus = false
            makeCorner(box, 5)
            makeStroke(box, Color3.fromRGB(255,255,255), 1, 0.9)
            box.Parent = row

            box.FocusLost:Connect(function(enterPressed)
                if enterPressed then
                    task.spawn(callback, box.Text)
                end
            end)

            return box
        end

        col.BackgroundTransparency = 1
        tween(col, {BackgroundTransparency = 0}, 0.35)

        table.insert(columns, colObj)
        return colObj
    end

    return window
end

return AxciaLib
