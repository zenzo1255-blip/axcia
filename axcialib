                                                    xciaText.Font = Enum.Font.GothamBlack
                                                    xciaText.TextTransparency = 1
                                                    xciaText.ZIndex = 10
                                                    xciaText.Parent = canvas

                                                    tween(xciaText, {
                                                        Size = UDim2.new(0, 160, 0, 60),
                                                        TextTransparency = 0
                                                    }, 0.5, Enum.EasingStyle.Quart)

                                                    local corners = {
                                                        {UDim2.new(0,-10,0,-10), Color3.fromRGB(80,80,255)},
                                                        {UDim2.new(1,-30,0,-10), Color3.fromRGB(80,80,255)},
                                                        {UDim2.new(0,-10,1,-30), Color3.fromRGB(80,80,255)},
                                                        {UDim2.new(1,-30,1,-30), Color3.fromRGB(80,80,255)},
                                                    }
                                                    for _, cd in ipairs(corners) do
                                                        local glow = Instance.new("Frame")
