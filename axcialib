    local function switchTab(idx)
        if idx == currentTabIndex then return end
        safeSound(1083195953, 0.3, 0.9 + idx * 0.05)

        local old = tabFrames[currentTabIndex]
        local new = tabFrames[idx]

        tween(old, {BackgroundTransparency = 1}, 0.18)
        local oldChildren = old:GetDescendants()
        for _, c in ipairs(oldChildren) do
            if c:IsA("TextLabel") or c:IsA("TextButton") then
                tween(c, {TextTransparency = 1}, 0.15)
            end
        end
        task.delay(0.2, function()
            old.Visible = false
            for _, c in ipairs(oldChildren) do
                if c:IsA("TextLabel") or c:IsA("TextButton") then
                    c.TextTransparency = 0
                end
            end
            if not old:IsA("Frame") or old.Name == "ColumnsTab" then
                old.BackgroundTransparency = 1
            else
                old.BackgroundTransparency = 0
            end
        end)

        currentTabIndex = idx
        new.Visible = true
        if new.Name ~= "ColumnsTab" then
            new.BackgroundTransparency = 1
            tween(new, {BackgroundTransparency = 0}, 0.2)
        end
        new.Position = new.Position + UDim2.new(0, 0, 0, 12)
        tween(new, {Position = new.Position - UDim2.new(0,0,0,12)}, 0.3, Enum.EasingStyle.Quart)
    end

