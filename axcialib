                                                task.delay(0.6, function()
                                                    local xciaText = Instance.new("TextLabel")
                                                    xciaText.Size = UDim2.new(0, 0, 0, 60)
                                                    xciaText.Position = UDim2.new(0.5, 40, 0.5, -30)
                                                    xciaText.AnchorPoint = Vector2.new(0, 0)
