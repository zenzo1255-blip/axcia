            nLbl.TextColor3 = Color3.fromRGB(205,205,212)
            nLbl.TextSize = 11
            nLbl.Font = Enum.Font.GothamBold
            nLbl.TextXAlignment = Enum.TextXAlignment.Left
            nLbl.Parent = topRow

            local vLbl = Instance.new("TextLabel")
            vLbl.Size = UDim2.new(0.28,0,1,0)
            vLbl.Position = UDim2.new(0.72,0,0,0)
            vLbl.BackgroundTransparency = 1
            vLbl.Text = tostring(value)
            vLbl.TextColor3 = Color3.fromRGB(0,190,95)
            vLbl.TextSize = 11
            vLbl.Font = Enum.Font.GothamBold
            vLbl.TextXAlignment = Enum.TextXAlignment.Right
            vLbl.Parent = topRow

            local trackBg = Instance.new("Frame")
            trackBg.Size = UDim2.new(1,0,0,5)
            trackBg.Position = UDim2.new(0,0,0,26)
            trackBg.BackgroundColor3 = Color3.fromRGB(42,42,48)
            trackBg.BorderSizePixel = 0
            corner(trackBg, 3)
            trackBg.Parent = row

            local pct = (value - minVal) / (maxVal - minVal)
            local fill = Instance.new("Frame")
            fill.Size = UDim2.new(pct,0,1,0)
            fill.BackgroundColor3 = Color3.fromRGB(0,190,95)
            fill.BorderSizePixel = 0
            corner(fill, 3)
            fill.Parent = trackBg

            local knob = Instance.new("Frame")
            knob.Size = UDim2.new(0,12,0,12)
            knob.Position = UDim2.new(pct,-6,0.5,-6)
            knob.BackgroundColor3 = Color3.fromRGB(255,255,255)
            knob.BorderSizePixel = 0
            corner(knob, 6)
            knob.Parent = trackBg

            local dragging = false
            trackBg.InputBegan:Connect(function(inp)
                if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                    dragging = true
                end
            end)
            UIS.InputEnded:Connect(function(inp)
                if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                    dragging = false
                end
            end)
            RunService.Heartbeat:Connect(function()
                if not dragging then return end
                local mpos = UIS:GetMouseLocation()
                local abs  = trackBg.AbsolutePosition
                local sz   = trackBg.AbsoluteSize
                local t    = math.clamp((mpos.X - abs.X) / sz.X, 0, 1)
                local nv   = math.floor(minVal + t * (maxVal - minVal) + 0.5)
                if nv ~= value then
                    value = nv
                    vLbl.Text = tostring(value)
                    fill.Size = UDim2.new(t,0,1,0)
                    knob.Position = UDim2.new(t,-6,0.5,-6)
                    task.spawn(callback, value)
                end
            end)

            local ref = {}
            function ref:Set(v)
                value = math.clamp(v, minVal, maxVal)
                local t = (value - minVal) / (maxVal - minVal)
                fill.Size = UDim2.new(t,0,1,0)
                knob.Position = UDim2.new(t,-6,0.5,-6)
                vLbl.Text = tostring(value)
                task.spawn(callback, value)
            end
            function ref:Get() return value end
            return ref
        end

        function colObj:AddDropdown(dOpts)
            dOpts = dOpts or {}
            local name     = (dOpts.Name or "Dropdown"):upper()
            local items    = dOpts.Items   or {}
            local default  = dOpts.Default or (items[1] or "")
            local callback = dOpts.Callback or function() end
            local selected = default
            local open     = false

            local wrapper = Instance.new("Frame")
            wrapper.Size = UDim2.new(1,0,0,38)
            wrapper.BackgroundTransparency = 1
            wrapper.ClipsDescendants = false
            wrapper.Parent = itemsFrame

            local nLbl = Instance.new("TextLabel")
            nLbl.Size = UDim2.new(1,0,0,16)
            nLbl.BackgroundTransparency = 1
            nLbl.Text = name
            nLbl.TextColor3 = Color3.fromRGB(205,205,212)
            nLbl.TextSize = 11
            nLbl.Font = Enum.Font.GothamBold
            nLbl.TextXAlignment = Enum.TextXAlignment.Left
            nLbl.Parent = wrapper

            local dropBtn = Instance.new("TextButton")
            dropBtn.Size = UDim2.new(1,0,0,20)
            dropBtn.Position = UDim2.new(0,0,0,17)
            dropBtn.BackgroundColor3 = Color3.fromRGB(26,26,30)
            dropBtn.Text = tostring(selected)
            dropBtn.TextColor3 = Color3.fromRGB(190,190,196)
            dropBtn.TextSize = 10
            dropBtn.Font = Enum.Font.GothamBold
            dropBtn.BorderSizePixel = 0
            corner(dropBtn, 5)
            dropBtn.Parent = wrapper

            local arrowLbl = Instance.new("TextLabel")
            arrowLbl.Size = UDim2.new(0,18,1,0)
            arrowLbl.Position = UDim2.new(1,-20,0,0)
            arrowLbl.BackgroundTransparency = 1
            arrowLbl.Text = "▼"
            arrowLbl.TextColor3 = Color3.fromRGB(140,140,150)
            arrowLbl.TextSize = 8
            arrowLbl.Font = Enum.Font.GothamBold
            arrowLbl.Parent = dropBtn

            local dropListFrame = Instance.new("Frame")
            dropListFrame.Size = UDim2.new(1,0,0,0)
            dropListFrame.Position = UDim2.new(0,0,1,2)
            dropListFrame.BackgroundColor3 = Color3.fromRGB(22,22,26)
            dropListFrame.BorderSizePixel = 0
            dropListFrame.ClipsDescendants = true
            dropListFrame.ZIndex = 20
            corner(dropListFrame, 5)
            dropListFrame.Parent = dropBtn

            local dListLayout = Instance.new("UIListLayout")
            dListLayout.Parent = dropListFrame

            for _, item in ipairs(items) do
                local opt = Instance.new("TextButton")
                opt.Size = UDim2.new(1,0,0,20)
                opt.BackgroundTransparency = 1
                opt.Text = tostring(item)
                opt.TextColor3 = Color3.fromRGB(185,185,192)
                opt.TextSize = 10
                opt.Font = Enum.Font.GothamBold
                opt.ZIndex = 21
                opt.Parent = dropListFrame
                opt.MouseButton1Click:Connect(function()
                    selected = tostring(item)
                    dropBtn.Text = selected
                    open = false
                    tw(dropListFrame, {Size = UDim2.new(1,0,0,0)}, 0.2, Enum.EasingStyle.Quart)
                    tw(arrowLbl, {Rotation = 0}, 0.2)
                    task.spawn(callback, selected)
                end)
                opt.MouseEnter:Connect(function()
                    tw(opt, {BackgroundTransparency = 0.8}, 0.1)
                    opt.BackgroundColor3 = Color3.fromRGB(255,255,255)
                end)
                opt.MouseLeave:Connect(function()
                    tw(opt, {BackgroundTransparency = 1}, 0.1)
                end)
            end

            dropBtn.MouseButton1Click:Connect(function()
                open = not open
                local targetH = open and (#items * 20) or 0
                tw(dropListFrame, {Size = UDim2.new(1,0,0,targetH)}, 0.2, Enum.EasingStyle.Quart)
                tw(arrowLbl, {Rotation = open and 180 or 0}, 0.2)
            end)

            local ref = {}
            function ref:Set(v)
                selected = v
                dropBtn.Text = v
                task.spawn(callback, v)
            end
            function ref:Get() return selected end
            return ref
        end

        function colObj:AddLabel(text)
            local lbl = Instance.new("TextLabel")
            lbl.Size = UDim2.new(1,0,0,24)
            lbl.BackgroundTransparency = 1
            lbl.Text = (text or ""):upper()
            lbl.TextColor3 = Color3.fromRGB(110,110,120)
            lbl.TextSize = 10
            lbl.Font = Enum.Font.GothamBold
            lbl.TextXAlignment = Enum.TextXAlignment.Left
            lbl.Parent = itemsFrame
            return lbl
        end

        function colObj:AddTextbox(tbOpts)
            tbOpts = tbOpts or {}
            local name        = (tbOpts.Name or "Input"):upper()
            local placeholder = tbOpts.Placeholder or ""
            local callback    = tbOpts.Callback or function() end

            local row = Instance.new("Frame")
            row.Size = UDim2.new(1,0,0,46)
            row.BackgroundTransparency = 1
            row.Parent = itemsFrame

            local nLbl = Instance.new("TextLabel")
            nLbl.Size = UDim2.new(1,0,0,16)
            nLbl.BackgroundTransparency = 1
            nLbl.Text = name
            nLbl.TextColor3 = Color3.fromRGB(205,205,212)
            nLbl.TextSize = 11
            nLbl.Font = Enum.Font.GothamBold
            nLbl.TextXAlignment = Enum.TextXAlignment.Left
            nLbl.Parent = row

            local box = Instance.new("TextBox")
            box.Size = UDim2.new(1,0,0,24)
            box.Position = UDim2.new(0,0,0,18)
            box.BackgroundColor3 = Color3.fromRGB(24,24,28)
            box.Text = ""
            box.PlaceholderText = placeholder
            box.PlaceholderColor3 = Color3.fromRGB(88,88,98)
            box.TextColor3 = Color3.fromRGB(205,205,212)
            box.TextSize = 11
            box.Font = Enum.Font.Gotham
            box.BorderSizePixel = 0
            box.ClearTextOnFocus = false
            corner(box, 5)
            stroke(box, Color3.fromRGB(255,255,255), 1, 0.88)
            box.Parent = row

            box.FocusLost:Connect(function(entered)
                if entered then task.spawn(callback, box.Text) end
            end)

            return box
        end

        return colObj
    end

    return win
end

return AxciaLib
