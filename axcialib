    mobileBtn.Text = "Toggle"
    mobileBtn.TextColor3 = Color3.fromRGB(220, 220, 225)
    mobileBtn.TextSize = 11
    mobileBtn.Font = Enum.Font.GothamBold
    mobileBtn.BorderSizePixel = 0
    mobileBtn.ZIndex = 50
    mobileBtn.Parent = _screenGui
    mkCorner(mobileBtn, 6)
    mkStroke(mobileBtn, Color3.fromRGB(255,255,255), 1, 0.8)

    local function toggleUI()
        _uiVisible = not _uiVisible
        snd(_uiVisible and 3306536429 or 3306536430, 0.4)

        if _uiVisible then
            tabBar.Visible = true
            tabBar.Position = UDim2.new(0.5, 0, 1, -6)
            tw(tabBar, {Position = UDim2.new(0.5, 0, 1, -18)}, 0.3, Enum.EasingStyle.Back)
            local cur = _tabFrames[_currentTab]
            cur.Visible = true
            if cur.Name ~= "ColTab" then
                cur.BackgroundTransparency = 1
                tw(cur, {BackgroundTransparency = 0.08}, 0.25)
            end
        else
            tw(tabBar, {Position = UDim2.new(0.5, 0, 1, 12)}, 0.22, Enum.EasingStyle.Quart)
            task.delay(0.24, function()
                tabBar.Visible = false
                for _, f in ipairs(_tabFrames) do
                    f.Visible = false
                end
            end)
        end
    end

    mobileBtn.MouseButton1Click:Connect(toggleUI)
    UIS.InputBegan:Connect(function(inp, gpe)
        if gpe then return end
        if inp.KeyCode == Enum.KeyCode.RightShift then toggleUI() end
    end)

    local rgbH = 0
    RunSvc.Heartbeat:Connect(function(dt)
        if not _cfg.RGBEnabled then return end
        rgbH = (rgbH + dt * 0.3) % 1
        local col = Color3.fromHSV(rgbH, 0.85, 1)
        for i, btn in ipairs(_tabBtns) do
            if i == _currentTab then
                local img = btn:FindFirstChildOfClass("ImageLabel")
                if img then img.ImageColor3 = col end
            end
        end
    end)
end

function AxciaLib:CreateWindow(opts)
    opts = opts or {}

    local saved = loadCfg()
    if saved then
        for k, v in pairs(saved) do _cfg[k] = v end
    end

    local win = {}
    local skipLoad = opts.SkipLoading or _cfg.SkipLoading

    local function init()
        buildUI()
    end

    if skipLoad then
        init()
    else
        runLoadingScreen(init)
    end

    function win:CreateColumn(colOpts)
        colOpts = colOpts or {}
        local title = colOpts.Title or "Column"

        local waited = 0
        while (not _colContainer) or (not _colContainer.Parent) do
            waited = waited + 1
            task.wait(0.05)
            if waited > 120 then break end
        end

        local col = Instance.new("Frame")
        col.Name = "Col_" .. title
        col.Size = UDim2.new(0, 198, 0, 0)
        col.AutomaticSize = Enum.AutomaticSize.Y
        col.BackgroundColor3 = Color3.fromRGB(13, 13, 15)
        col.BorderSizePixel = 0
        col.BackgroundTransparency = 0
        col.ClipsDescendants = false
        col.Parent = _colContainer
        mkCorner(col, 8)
        mkStroke(col, Color3.fromRGB(255,255,255), 1, 0.86)

        local colTitle = Instance.new("TextLabel")
        colTitle.Size = UDim2.new(1, 0, 0, 34)
        colTitle.Position = UDim2.new(0, 0, 0, 0)
        colTitle.BackgroundTransparency = 1
        colTitle.Text = title:upper()
        colTitle.TextColor3 = Color3.fromRGB(255, 255, 255)
        colTitle.TextSize = 11
        colTitle.Font = Enum.Font.GothamBold
        colTitle.ZIndex = 2
        colTitle.Parent = col

        local sep = Instance.new("Frame")
        sep.Size = UDim2.new(1, 0, 0, 1)
        sep.Position = UDim2.new(0, 0, 0, 34)
        sep.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        sep.BackgroundTransparency = 0.86
        sep.BorderSizePixel = 0
        sep.ZIndex = 2
        sep.Parent = col

        local itemsHolder = Instance.new("Frame")
        itemsHolder.Name = "Items"
        itemsHolder.Size = UDim2.new(1, 0, 0, 0)
        itemsHolder.Position = UDim2.new(0, 0, 0, 35)
        itemsHolder.AutomaticSize = Enum.AutomaticSize.Y
        itemsHolder.BackgroundTransparency = 1
        itemsHolder.ZIndex = 2
        itemsHolder.Parent = col

        local itemLayout = Instance.new("UIListLayout")
        itemLayout.Padding = UDim.new(0, 0)
        itemLayout.Parent = itemsHolder

        local itemPad = Instance.new("UIPadding")
        itemPad.PaddingLeft   = UDim.new(0, 12)
        itemPad.PaddingRight  = UDim.new(0, 12)
        itemPad.PaddingBottom = UDim.new(0, 8)
        itemPad.Parent = itemsHolder

        local obj = {}

        function obj:AddToggle(tOpts)
            tOpts = tOpts or {}
            local name     = tOpts.Name or "Toggle"
            local default  = tOpts.Default or false
            local callback = tOpts.Callback or function() end
            local state    = default

            local row = Instance.new("Frame")
            row.Size = UDim2.new(1, 0, 0, 34)
            row.BackgroundTransparency = 1
            row.ZIndex = 2
            row.Parent = itemsHolder

            local nameLbl = Instance.new("TextLabel")
            nameLbl.Size = UDim2.new(1, -40, 1, 0)
            nameLbl.BackgroundTransparency = 1
            nameLbl.Text = name:upper()
            nameLbl.TextColor3 = Color3.fromRGB(200, 200, 208)
            nameLbl.TextSize = 11
            nameLbl.Font = Enum.Font.GothamBold
            nameLbl.TextXAlignment = Enum.TextXAlignment.Left
            nameLbl.ZIndex = 2
            nameLbl.Parent = row

            local togBg = Instance.new("Frame")
            togBg.Size = UDim2.new(0, 28, 0, 14)
            togBg.Position = UDim2.new(1, -30, 0.5, -7)
            togBg.BackgroundColor3 = state and Color3.fromRGB(0, 185, 90) or Color3.fromRGB(38, 38, 44)
            togBg.BorderSizePixel = 0
            togBg.ZIndex = 3
            mkCorner(togBg, 7)
            togBg.Parent = row

            local knob = Instance.new("Frame")
            knob.Size = UDim2.new(0, 10, 0, 10)
            knob.Position = state and UDim2.new(0, 16, 0.5, -5) or UDim2.new(0, 2, 0.5, -5)
            knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            knob.BorderSizePixel = 0
            knob.ZIndex = 4
            mkCorner(knob, 5)
            knob.Parent = togBg

            local hitbox = Instance.new("TextButton")
            hitbox.Size = UDim2.new(1, 0, 1, 0)
            hitbox.BackgroundTransparency = 1
            hitbox.Text = ""
            hitbox.ZIndex = 4
            hitbox.Parent = row

            hitbox.MouseButton1Click:Connect(function()
                state = not state
                snd(876939830, 0.25, state and 1.06 or 0.87)
                tw(togBg, {BackgroundColor3 = state and Color3.fromRGB(0,185,90) or Color3.fromRGB(38,38,44)}, 0.2)
                tw(knob, {Position = state and UDim2.new(0,16,0.5,-5) or UDim2.new(0,2,0.5,-5)}, 0.2, Enum.EasingStyle.Back)
                task.spawn(callback, state)
            end)

            local ref = {}
            function ref:Set(v)
                state = v
                tw(togBg, {BackgroundColor3 = state and Color3.fromRGB(0,185,90) or Color3.fromRGB(38,38,44)}, 0.2)
                tw(knob, {Position = state and UDim2.new(0,16,0.5,-5) or UDim2.new(0,2,0.5,-5)}, 0.2, Enum.EasingStyle.Back)
                task.spawn(callback, state)
            end
            function ref:Get() return state end
            return ref
        end

        function obj:AddButton(bOpts)
            bOpts = bOpts or {}
            local name     = bOpts.Name or "Button"
            local callback = bOpts.Callback or function() end

            local row = Instance.new("Frame")
            row.Size = UDim2.new(1, 0, 0, 36)
            row.BackgroundTransparency = 1
            row.ZIndex = 2
            row.Parent = itemsHolder

            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(1, 0, 0, 26)
            btn.Position = UDim2.new(0, 0, 0.5, -13)
            btn.BackgroundColor3 = Color3.fromRGB(22, 22, 26)
            btn.Text = name:upper()
            btn.TextColor3 = Color3.fromRGB(190, 190, 200)
            btn.TextSize = 10
            btn.Font = Enum.Font.GothamBold
            btn.BorderSizePixel = 0
            btn.ZIndex = 2
            mkCorner(btn, 5)
            mkStroke(btn, Color3.fromRGB(255,255,255), 1, 0.9)
            btn.Parent = row

            btn.MouseEnter:Connect(function()
                tw(btn, {BackgroundColor3 = Color3.fromRGB(30, 30, 35)}, 0.12)
            end)
            btn.MouseLeave:Connect(function()
                tw(btn, {BackgroundColor3 = Color3.fromRGB(22, 22, 26)}, 0.12)
            end)
            btn.MouseButton1Click:Connect(function()
                ripple(btn)
                snd(876939830, 0.2, 1.3)
                task.spawn(callback)
            end)
        end

        function obj:AddSlider(sOpts)
            sOpts = sOpts or {}
            local name     = sOpts.Name or "Slider"
            local minV     = sOpts.Min or 0
            local maxV     = sOpts.Max or 100
            local defV     = sOpts.Default or minV
            local callback = sOpts.Callback or function() end
            local value    = math.clamp(defV, minV, maxV)

            local row = Instance.new("Frame")
            row.Size = UDim2.new(1, 0, 0, 44)
            row.BackgroundTransparency = 1
            row.ZIndex = 2
            row.Parent = itemsHolder

            local topRow = Instance.new("Frame")
            topRow.Size = UDim2.new(1, 0, 0, 18)
            topRow.BackgroundTransparency = 1
            topRow.ZIndex = 2
            topRow.Parent = row

            local nLbl = Instance.new("TextLabel")
            nLbl.Size = UDim2.new(0.7, 0, 1, 0)
            nLbl.BackgroundTransparency = 1
            nLbl.Text = name:upper()
            nLbl.TextColor3 = Color3.fromRGB(200, 200, 208)
            nLbl.TextSize = 11
            nLbl.Font = Enum.Font.GothamBold
            nLbl.TextXAlignment = Enum.TextXAlignment.Left
            nLbl.ZIndex = 2
            nLbl.Parent = topRow

            local vLbl = Instance.new("TextLabel")
            vLbl.Size = UDim2.new(0.3, 0, 1, 0)
            vLbl.Position = UDim2.new(0.7, 0, 0, 0)
            vLbl.BackgroundTransparency = 1
            vLbl.Text = tostring(value)
            vLbl.TextColor3 = Color3.fromRGB(0, 185, 90)
            vLbl.TextSize = 11
            vLbl.Font = Enum.Font.GothamBold
            vLbl.TextXAlignment = Enum.TextXAlignment.Right
            vLbl.ZIndex = 2
            vLbl.Parent = topRow

            local track = Instance.new("Frame")
            track.Size = UDim2.new(1, 0, 0, 4)
            track.Position = UDim2.new(0, 0, 0, 28)
            track.BackgroundColor3 = Color3.fromRGB(36, 36, 42)
            track.BorderSizePixel = 0
            track.ZIndex = 2
            mkCorner(track, 2)
            track.Parent = row

            local pct = (value - minV) / (maxV - minV)

            local fill = Instance.new("Frame")
            fill.Size = UDim2.new(pct, 0, 1, 0)
            fill.BackgroundColor3 = Color3.fromRGB(0, 185, 90)
            fill.BorderSizePixel = 0
            fill.ZIndex = 3
            mkCorner(fill, 2)
            fill.Parent = track

            local knob = Instance.new("Frame")
            knob.Size = UDim2.new(0, 12, 0, 12)
            knob.Position = UDim2.new(pct, -6, 0.5, -6)
            knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            knob.BorderSizePixel = 0
            knob.ZIndex = 4
            mkCorner(knob, 6)
            knob.Parent = track

            local drag = false

            track.InputBegan:Connect(function(inp)
                if inp.UserInputType == Enum.UserInputType.MouseButton1
                or inp.UserInputType == Enum.UserInputType.Touch then
                    drag = true
                end
            end)
            UIS.InputEnded:Connect(function(inp)
                if inp.UserInputType == Enum.UserInputType.MouseButton1
                or inp.UserInputType == Enum.UserInputType.Touch then
                    drag = false
                end
            end)
            RunSvc.Heartbeat:Connect(function()
                if not drag then return end
                local mpos = UIS:GetMouseLocation()
                local abs  = track.AbsolutePosition
                local sz   = track.AbsoluteSize
                local t    = math.clamp((mpos.X - abs.X) / sz.X, 0, 1)
                local nv   = math.floor(minV + t * (maxV - minV) + 0.5)
                if nv ~= value then
                    value = nv
                    fill.Size    = UDim2.new(t, 0, 1, 0)
                    knob.Position = UDim2.new(t, -6, 0.5, -6)
                    vLbl.Text    = tostring(value)
                    task.spawn(callback, value)
                end
            end)

            local ref = {}
            function ref:Set(v)
                value = math.clamp(v, minV, maxV)
                local t = (value - minV) / (maxV - minV)
                fill.Size    = UDim2.new(t, 0, 1, 0)
                knob.Position = UDim2.new(t, -6, 0.5, -6)
                vLbl.Text    = tostring(value)
                task.spawn(callback, value)
            end
            function ref:Get() return value end
            return ref
        end

        function obj:AddDropdown(dOpts)
            dOpts = dOpts or {}
            local name     = dOpts.Name or "Dropdown"
            local items    = dOpts.Items or {}
            local default  = dOpts.Default or (items[1] or "")
            local callback = dOpts.Callback or function() end
            local selected = default
            local open     = false

            local wrapper = Instance.new("Frame")
            wrapper.Size = UDim2.new(1, 0, 0, 40)
            wrapper.BackgroundTransparency = 1
            wrapper.ClipsDescendants = false
            wrapper.ZIndex = 2
            wrapper.Parent = itemsHolder

            local nLbl = Instance.new("TextLabel")
            nLbl.Size = UDim2.new(1, 0, 0, 16)
            nLbl.BackgroundTransparency = 1
            nLbl.Text = name:upper()
            nLbl.TextColor3 = Color3.fromRGB(200, 200, 208)
            nLbl.TextSize = 11
            nLbl.Font = Enum.Font.GothamBold
            nLbl.TextXAlignment = Enum.TextXAlignment.Left
            nLbl.ZIndex = 2
            nLbl.Parent = wrapper

            local dropBtn = Instance.new("TextButton")
            dropBtn.Size = UDim2.new(1, 0, 0, 20)
            dropBtn.Position = UDim2.new(0, 0, 0, 18)
            dropBtn.BackgroundColor3 = Color3.fromRGB(22, 22, 26)
            dropBtn.Text = tostring(selected)
            dropBtn.TextColor3 = Color3.fromRGB(185, 185, 195)
            dropBtn.TextSize = 10
            dropBtn.Font = Enum.Font.GothamBold
            dropBtn.BorderSizePixel = 0
            dropBtn.ZIndex = 3
            mkCorner(dropBtn, 5)
            dropBtn.Parent = wrapper

            local arrow = Instance.new("TextLabel")
            arrow.Size = UDim2.new(0, 16, 1, 0)
            arrow.Position = UDim2.new(1, -18, 0, 0)
            arrow.BackgroundTransparency = 1
            arrow.Text = "▾"
            arrow.TextColor3 = Color3.fromRGB(130, 130, 140)
            arrow.TextSize = 10
            arrow.Font = Enum.Font.GothamBold
            arrow.ZIndex = 4
            arrow.Parent = dropBtn

            local listFrame = Instance.new("Frame")
            listFrame.Size = UDim2.new(1, 0, 0, 0)
            listFrame.Position = UDim2.new(0, 0, 1, 2)
            listFrame.BackgroundColor3 = Color3.fromRGB(18, 18, 22)
            listFrame.BorderSizePixel = 0
            listFrame.ClipsDescendants = true
            listFrame.ZIndex = 20
            mkCorner(listFrame, 5)
            listFrame.Parent = dropBtn

            local listLayout = Instance.new("UIListLayout")
            listLayout.Parent = listFrame

            for _, item in ipairs(items) do
                local opt = Instance.new("TextButton")
                opt.Size = UDim2.new(1, 0, 0, 20)
                opt.BackgroundTransparency = 1
                opt.Text = tostring(item)
                opt.TextColor3 = Color3.fromRGB(180, 180, 190)
                opt.TextSize = 10
                opt.Font = Enum.Font.GothamBold
                opt.ZIndex = 21
                opt.Parent = listFrame

                opt.MouseEnter:Connect(function()
                    opt.BackgroundTransparency = 0.85
                    opt.BackgroundColor3 = Color3.fromRGB(255,255,255)
                end)
                opt.MouseLeave:Connect(function()
                    opt.BackgroundTransparency = 1
                end)
                opt.MouseButton1Click:Connect(function()
                    selected = tostring(item)
                    dropBtn.Text = selected
                    open = false
                    tw(listFrame, {Size = UDim2.new(1,0,0,0)}, 0.18, Enum.EasingStyle.Quart)
                    tw(arrow, {Rotation = 0}, 0.18)
                    task.spawn(callback, selected)
                end)
            end

            dropBtn.MouseButton1Click:Connect(function()
                open = not open
                tw(listFrame, {Size = UDim2.new(1,0,0, open and (#items * 20) or 0)}, 0.2, Enum.EasingStyle.Quart)
                tw(arrow, {Rotation = open and 180 or 0}, 0.2)
            end)

            local ref = {}
            function ref:Set(v) selected = v; dropBtn.Text = v; task.spawn(callback, v) end
            function ref:Get() return selected end
            return ref
        end

        function obj:AddLabel(text)
            local lbl = Instance.new("TextLabel")
            lbl.Size = UDim2.new(1, 0, 0, 22)
            lbl.BackgroundTransparency = 1
            lbl.Text = (text or ""):upper()
            lbl.TextColor3 = Color3.fromRGB(90, 90, 100)
            lbl.TextSize = 10
            lbl.Font = Enum.Font.GothamBold
            lbl.TextXAlignment = Enum.TextXAlignment.Left
            lbl.ZIndex = 2
            lbl.Parent = itemsHolder
            return lbl
        end

        function obj:AddTextbox(tbOpts)
            tbOpts = tbOpts or {}
            local name        = tbOpts.Name or "Input"
            local placeholder = tbOpts.Placeholder or ""
            local callback    = tbOpts.Callback or function() end

            local row = Instance.new("Frame")
            row.Size = UDim2.new(1, 0, 0, 44)
            row.BackgroundTransparency = 1
            row.ZIndex = 2
            row.Parent = itemsHolder

            local nLbl = Instance.new("TextLabel")
            nLbl.Size = UDim2.new(1, 0, 0, 16)
            nLbl.BackgroundTransparency = 1
            nLbl.Text = name:upper()
            nLbl.TextColor3 = Color3.fromRGB(200, 200, 208)
            nLbl.TextSize = 11
            nLbl.Font = Enum.Font.GothamBold
            nLbl.TextXAlignment = Enum.TextXAlignment.Left
            nLbl.ZIndex = 2
            nLbl.Parent = row

            local box = Instance.new("TextBox")
            box.Size = UDim2.new(1, 0, 0, 22)
            box.Position = UDim2.new(0, 0, 0, 18)
            box.BackgroundColor3 = Color3.fromRGB(20, 20, 24)
            box.Text = ""
            box.PlaceholderText = placeholder
            box.PlaceholderColor3 = Color3.fromRGB(80, 80, 90)
            box.TextColor3 = Color3.fromRGB(200, 200, 208)
            box.TextSize = 11
            box.Font = Enum.Font.Gotham
            box.BorderSizePixel = 0
            box.ClearTextOnFocus = false
            box.ZIndex = 2
            mkCorner(box, 5)
            mkStroke(box, Color3.fromRGB(255,255,255), 1, 0.88)
            box.Parent = row

            box.FocusLost:Connect(function(enter)
                if enter then task.spawn(callback, box.Text) end
            end)

            return box
        end

        return obj
    end

    return win
end

return AxciaLib
